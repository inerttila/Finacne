# Neon URL for live (Render) and for running the server outside Compose.
# `docker compose up` ignores this for the app and uses local Postgres instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
HOST=0.0.0.0
PORT=8080

# Hexclave (injected automatically by `npm run dev` via `hexclave dev`).
# For production / Render, set these from the Hexclave / Stack Auth dashboard.
HEXCLAVE_PROJECT_ID=
HEXCLAVE_SECRET_SERVER_KEY=
VITE_HEXCLAVE_PROJECT_ID=
