{
  "name": "net-ledger",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "hexclave dev --config-file ./hexclave.config.ts -- npm run dev:inner",
    "dev:inner": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "node server/src/index.js",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "@hexclave/cli": "^1.0.134",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@hexclave/js": "^1.0.134"
  }
}
